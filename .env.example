# .env.example

# PostgreSQL connection string (SQLAlchemy format)
DATABASE_URL=postgresql://username:password@localhost:5432/resolve_db

# Hindsight (long‑term memory) credentials
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BANK_ID=your_hindsight_bank_id_here

# LLM provider configuration (generic placeholders)
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=your_preferred_model_name_here

# Frontend configuration – URL of the backend API (used by Next.js runtime)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: other service keys can be added as needed.
